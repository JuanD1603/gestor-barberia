# Configuración de Base de Datos
DATABASE_URL=mysql+pymysql://barber_user:barber_password@127.0.0.1:3306/barberia_db

# Para entorno de desarrollo local con SQLite (opcional y sin dependencias externas):
# DATABASE_URL=sqlite:///./barberia.db

# Configuración de Servidor y Seguridad
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion

# Enlace de recuperación de contraseña (RF-04): dirección donde corre el frontend
FRONTEND_URL=http://localhost:5173

# Correo saliente (RF-04, RF-07, RF-21, RF-25). Si SMTP_HOST se deja vacío, los correos no se envían y la
# consola del backend lo avisa ("Correo no enviado"), sin mostrar su contenido.
# El backend lee este archivo (copiado como .env) solo al arrancar: después de editarlo, deténlo y vuelve a
# iniciarlo. uvicorn --reload no lo vuelve a leer.
#
# Para enviar desde una cuenta de Gmail (reemplaza tu_cuenta@gmail.com por la cuenta remitente real):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587                 (STARTTLS; también sirve 465 con SSL)
#   SMTP_USER=tu_cuenta@gmail.com
#   SMTP_PASSWORD=<contraseña de aplicación de 16 caracteres>
#   SMTP_FROM_EMAIL=tu_cuenta@gmail.com   (Gmail exige que sea la misma cuenta de SMTP_USER)
# La contraseña de aplicación se crea en https://myaccount.google.com/apppasswords y exige tener activada
# la verificación en 2 pasos. NO uses la contraseña normal de la cuenta y NO escribas la real en este archivo:
# va solo en tu archivo .env, que no se sube al repositorio.
# Prueba real de envío (desde src/backend; envía UN correo solo a la dirección indicada y muestra si el
# servidor lo aceptó): python notificaciones.py tu_cuenta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BarberShop Pro

# Datos iniciales (python seed.py). Si no se definen las contraseñas, el seed genera unas aleatorias
# y las muestra una sola vez en consola.
SEED_ADMIN_EMAIL=admin@barbershop.pro
SEED_ADMIN_PASSWORD=
SEED_BARBEROS_PASSWORD=
